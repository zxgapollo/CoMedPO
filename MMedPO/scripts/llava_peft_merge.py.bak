import argparse
from transformers import AutoTokenizer, AutoModelForCausalLM
from peft import PeftModel
import torch
from llava.model.builder import load_pretrained_model
from llava.mm_utils import get_model_name_from_path
import os

def merge_lora(base_model_path, lora_checkpoint_path, output_path):
    print(f"Loading base model from {base_model_path}")
    
    # Explicitly set model_name to "llava_mistral"
    tokenizer, model, image_processor, _ = load_pretrained_model(
        model_path=lora_checkpoint_path,
        model_base=base_model_path,
        model_name="llava_mistral",
        device_map=None,
        load_4bit=False, 
        load_8bit=False
    )

    model.save_pretrained(output_path)
    tokenizer.save_pretrained(output_path)
    if image_processor:
        image_processor.save_pretrained(output_path)

if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--base_model_path", type=str, required=True)
    parser.add_argument("--lora_checkpoint_path", type=str, required=True)
    parser.add_argument("--output_path", type=str, required=True)
    args = parser.parse_args()

    merge_lora(args.base_model_path, args.lora_checkpoint_path, args.output_path)